# baton configuration
#
# Use it with:  baton --env-file /path/to/this/file
# or export these keys as environment variables / pass them as flags.
#
# Precedence: CLI flag > environment variable > config file > built-in default.
# baton does NOT look for this file anywhere automatically — you point --env-file
# at it explicitly (or set the keys as env vars/flags).
#
# NOTE: baton does NOT need your media folder path. It never reads your music
# files — it matches songs by tag through MPD and Navidrome, which both already
# know your library. You only configure how to reach them.
#
# IMPORTANT: MPD and Navidrome must be pointed at the SAME music folder. Tag
# matching only works because both index the same files.

# Navidrome account baton authenticates as. Use the SAME account as your music
# clients (MPD/Malp, Feishin, Tempo, Tempus, Resonus...) so they all share one
# play queue -> "continue on another device". Navidrome keeps one queue per user;
# "last active device wins" is the intended behavior.
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# Navidrome Subsonic URL reachable from baton.
#  - systemd (native):  http://127.0.0.1:4533
#  - docker (bridge):   http://172.17.0.1:4533  (172.17.0.1 is the docker gateway -> host)
NAVIDROME_URL=http://127.0.0.1:4533
# Set to 1 if your server only supports legacy plaintext auth (not Navidrome).
NAVIDROME_LEGACY_AUTH=0

# MPD host/port reachable from baton.
#  - systemd (native): 127.0.0.1
#  - docker (bridge):  172.17.0.1
MPD_HOST=127.0.0.1
MPD_PORT=6600
MPD_PASSWORD=

# How often (seconds) baton polls both MPD and Navidrome.
POLL_INTERVAL=5

# Sync mode: auto (push+pull), manual (only on demand), or push/pull (one direction only).
MODE=auto

# Status API + web UI listen address.
BATON_LISTEN=127.0.0.1:8080
# Optional bearer token protecting /api/*. Leave empty for no auth.
BATON_API_TOKEN=
